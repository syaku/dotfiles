{{- if eq .chezmoi.os "windows" -}}
# herdr の plugin（syaku.claude-tab-title）を登録する。Mac では同じ処理を .sh 版が行う。
# herdr は manifest を登録したときに読むので、manifest が変わったら登録し直す。
# manifest hash: {{ include "dot_config/herdr/plugins/claude-tab-title/herdr-plugin.toml" | sha256sum }}

$pluginDir = Join-Path $HOME '.config\herdr\plugins\claude-tab-title'

& herdr.exe plugin unlink syaku.claude-tab-title 2>&1 | Out-Null
& herdr.exe plugin link $pluginDir
exit $LASTEXITCODE
{{- end -}}
