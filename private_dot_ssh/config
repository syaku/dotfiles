Host github.com
  User git
  IdentityFile ~/.ssh/id_ed25519

HOST pve.syaku.me
  User root
  IdentityFile ~/.ssh/id_ed25519
  SetEnv TERM=xterm-256color

HOST app.syaku.me
  User root
  IdentityFile ~/.ssh/id_ed25519
  SetEnv TERM=xterm-256color

HOST apps-vm
  HostName app.syaku.me
  User root
  IdentityFile ~/.ssh/id_ed25519
  SetEnv TERM=xterm-256color

# k3s のノードは svc zone にあり、PVE を経由して入る。
HOST k3s
  HostName 10.20.20.10
  User root
  ProxyJump pve.syaku.me
  IdentityFile ~/.ssh/id_ed25519
  SetEnv TERM=xterm-256color

