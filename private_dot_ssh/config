Host github.com
  User git
  IdentityFile ~/.ssh/id_ed25519

# DNS (Technitium) が止まっていても PVE に入って直せるよう、名前を引かずに IP で入る。
# PVE を経由する ProxyJump (k3s、ansible、terraform の null_resource) もこれに乗る。
HOST pve.syaku.me
  HostName 192.168.0.10
  User root
  IdentityFile ~/.ssh/id_ed25519
  SetEnv TERM=xterm-256color

# app.syaku.me は内部の wildcard で 10.20.20.2 に解決される。k3s 移行 Phase 8 から .2 は k3s のノードにある。
HOST app.syaku.me
  User root
  IdentityFile ~/.ssh/id_ed25519
  SetEnv TERM=xterm-256color

# k3s のノードは svc zone にあり、PVE を経由して入る。
HOST k3s
  HostName 10.20.20.10
  User root
  ProxyJump pve.syaku.me
  IdentityFile ~/.ssh/id_ed25519
  SetEnv TERM=xterm-256color

