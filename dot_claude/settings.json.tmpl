{
  "cleanupPeriodDays": 180,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_GIT_BASH_PATH": "C:\\Program Files\\Git\\bin\\bash.exe",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git stash list)",
      "Bash(chezmoi diff)",
      "Bash(chezmoi diff *)",
      "Bash(chezmoi source-path)",
      "Bash(chezmoi source-path *)",
      "Bash(chezmoi status)",
      "Bash(chezmoi status *)",
      "Bash(chezmoi managed)",
      "Bash(chezmoi managed *)",
      "Bash(chezmoi ignored)",
      "Bash(chezmoi ignored *)",
      "Bash(chezmoi cat *)",
      "Bash(chezmoi data)",
      "Bash(chezmoi data *)",
      "Bash(chezmoi execute-template *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "WebFetch(domain:localhost)",
      "WebFetch(domain:127.0.0.1)",
      "WebFetch(domain:0.0.0.0)",
      "WebFetch(domain:169.254.169.254)",
      "WebFetch(domain:*.local)",
      "WebFetch(domain:*.internal)",
      "Artifact",
      "SendFeedback",
      "ScheduleWakeup",
      "ReportFindings"
    ],
    "ask": [
      "Bash(screencapture)",
      "Bash(screencapture *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/plugin-version-drift.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/session_memory.py start"
          }
        ]
      }
{{- /* herdr は chezmoi 管理外の machine-local インストール。script がある環境でだけ登録する。
       command は herdr integration install が書く文字列と同じ形にし、install を再実行しても二重登録にならないようにする。
       Windows は .ps1 を powershell で呼ぶ（herdr 0.8.2 src/integration/command.rs）。joinPath は Windows で
       区切りが混在するので、パスは homeDir の連結で組む。 */}}
{{- if eq .chezmoi.os "windows" }}
{{-   if stat (joinPath .chezmoi.homeDir ".claude/hooks/herdr-agent-state.ps1") }},
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"{{ .chezmoi.homeDir | replace "/" "\\\\" }}\\.claude\\hooks\\herdr-agent-state.ps1\" session",
            "timeout": 10
          }
        ]
      }
{{-   end }}
{{- else }}
{{-   if stat (joinPath .chezmoi.homeDir ".claude/hooks/herdr-agent-state.sh") }},
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ joinPath .chezmoi.homeDir ".claude/hooks/herdr-agent-state.sh" }}' session",
            "timeout": 10
          }
        ]
      }
{{-   end }}
{{- end }}
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/session_memory.py end",
            "timeout": 10
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/instructions-loaded-log.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/chezmoi-source-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/format-on-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"terminalSequence\":\"\\u0007\"}'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh",
    "padding": 0
  },
{{- /* enabledPlugins / extraKnownMarketplaces はランタイムで target に書き戻され常時 drift するため
       chezmoi 管理外の <workspace>/.claude/settings.local.json に置く（2026-09-10）。
       空スタブは anthropics/claude-code#27247（User 側にキーが無いと Local 側が無視される。
       closed NOT_PLANNED で未修正）の回避策として残す。 */}}
  "enabledPlugins": {},
  "language": "日本語",
  "outputStyle": "concise-plain",
  "advisorModel": "fable",
  "pluginConfigs": {
    "personal-misc@syaku-claude-plugins": {
      "options": {
        "journal_dir": "/Users/syaku/workspace/notes/obsidian/Life/notes",
        "journal_template": "/Users/syaku/workspace/notes/obsidian/Life/templates/daily.md",
        "trend_note_dir": "/Users/syaku/workspace/notes/obsidian/Life/skill/tech-trends",
        "chronicle_lore_note": "/Users/syaku/workspace/notes/obsidian/Life/notes/イルミア年代記.md",
        "chronicle_dir": "/Users/syaku/workspace/notes/obsidian/Life/skill/illumia-chronicle"
      }
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true,
{{- /* 常時読み込みの削減（2026-09-22）。tool 定義・skill 一覧・auto memory が
       固定文脈の大半を占めていたため、この workspace で使っていないものを外す。deny に素の tool 名を
       書くと定義そのものが context から消える。deny は全設定ファイルの合算で allow の例外を作れないので、
       Artifact が要る session ではこの行を外して chezmoi apply する。 */}}
  "skillListingMaxDescChars": 400,
  "autoMemoryEnabled": false
{{- $am := joinPath ".automode-environments" (printf "%s.json" .chezmoi.hostname) }}
{{- if stat (joinPath .chezmoi.sourceDir $am) }},
  "autoMode": {{ include $am }}
{{- end }}
}
