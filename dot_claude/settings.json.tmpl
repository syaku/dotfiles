{
  "cleanupPeriodDays": 180,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_GIT_BASH_PATH": "C:\\Program Files\\Git\\bin\\bash.exe",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git stash list)",
      "Bash(chezmoi diff)",
      "Bash(chezmoi diff *)",
      "Bash(chezmoi source-path)",
      "Bash(chezmoi source-path *)",
      "Bash(chezmoi status)",
      "Bash(chezmoi status *)",
      "Bash(chezmoi managed)",
      "Bash(chezmoi managed *)",
      "Bash(chezmoi ignored)",
      "Bash(chezmoi ignored *)",
      "Bash(chezmoi cat *)",
      "Bash(chezmoi data)",
      "Bash(chezmoi data *)",
      "Bash(chezmoi execute-template *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "WebFetch(domain:localhost)",
      "WebFetch(domain:127.0.0.1)",
      "WebFetch(domain:0.0.0.0)",
      "WebFetch(domain:169.254.169.254)",
      "WebFetch(domain:*.local)",
      "WebFetch(domain:*.internal)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(gh pr create *)",
      "Bash(screencapture)",
      "Bash(screencapture *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/plugin-version-drift.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/session_memory.py start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/session_memory.py end",
            "timeout": 10
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/instructions-loaded-log.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/chezmoi-source-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/format-on-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' '{\"terminalSequence\":\"\\u0007\"}'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh",
    "padding": 0
  },
{{- /* enabledPlugins / extraKnownMarketplaces はランタイムで target に書き戻され常時 drift するため
       chezmoi 管理外の <workspace>/.claude/settings.local.json に置く（2026-09-10）。
       空スタブは anthropics/claude-code#27247（User 側にキーが無いと Local 側が無視される。
       closed NOT_PLANNED で未修正）の回避策として残す。 */}}
  "enabledPlugins": {},
  "language": "日本語",
  "outputStyle": "Concise",
  "advisorModel": "fable",
  "pluginConfigs": {
    "personal-misc@syaku-claude-plugins": {
      "options": {
        "journal_dir": "/Users/syaku/workspace/notes/obsidian/Life/notes",
        "journal_template": "/Users/syaku/workspace/notes/obsidian/Life/templates/daily.md",
        "trend_note_dir": "/Users/syaku/workspace/notes/obsidian/Life/skill/tech-trends",
        "chronicle_lore_note": "/Users/syaku/workspace/notes/obsidian/Life/notes/イルミア年代記.md",
        "chronicle_dir": "/Users/syaku/workspace/notes/obsidian/Life/skill/illumia-chronicle"
      }
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true
{{- $am := joinPath ".automode-environments" (printf "%s.json" .chezmoi.hostname) }}
{{- if stat (joinPath .chezmoi.sourceDir $am) }},
  "autoMode": {{ include $am }}
{{- end }}
}
